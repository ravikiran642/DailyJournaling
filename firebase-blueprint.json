{
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "lastLoginAt": { "type": "string", "description": "ISO timestamp of last login" }
      }
    },
    "JournalEntry": {
      "collection": "users/{userId}/journalEntries",
      "fields": {
        "id": { "type": "string", "description": "Unique ID of the journal entry" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Title or autogenerated prompt preview" },
        "initialPrompt": { "type": "string", "description": "The starting reflection or entry" },
        "content": { "type": "string", "description": "Rich-text journal document content" },
        "journalDate": { "type": "string", "description": "Local calendar date of the entry YYYY-MM-DD" },
        "isDailyPrimary": { "type": "boolean", "description": "Whether this is the primary reflection for the calendar day" },
        "reflectionType": { "type": "string", "description": "Type: daily, general, brainstorm, gratitude, emotional-checkin, decision-making" },
        "summary": { "type": "string", "description": "AI-generated executive summary or takeaway" },
        "synthesis": { "type": "string", "description": "AI-generated reflective synthesis" },
        "keyInsights": { "type": "array", "description": "List of key takeaways" },
        "tags": { "type": "array", "description": "Tags/categories for entry" },
        "messages": { "type": "array", "description": "Multi-turn interaction messages [{role, content, timestamp}]" },
        "embedding": { "type": "array", "description": "Vector embedding of entry summary/themes for semantic Echo retrieval" },
        "embeddingSourceHash": { "type": "string", "description": "Hash of semantic text to track embedding freshness" },
        "confirmedEchoContext": { "type": "array", "description": "Historical echoes confirmed by user for active session context" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last interaction" }
      }
    }
  }
}
